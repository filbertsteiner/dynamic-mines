# Optional: override the Dynamic environment ID at build time.
# If unset, the app falls back to the sandbox environment baked into src/config.ts.
# The environment ID is a PUBLIC client identifier (not a secret).
VITE_DYNAMIC_ENVIRONMENT_ID=

# Optional: enable the SHARED global leaderboard (Supabase). See SUPABASE_SETUP.md.
# Both are PUBLIC client values (safe to ship) — the "anon" key is protected by
# row-level security, NOT a secret. If either is unset, the leaderboard falls
# back to the local bots-only board. Never put the Supabase service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
